{
    "name": "@ehfuse/mua-ui",
    "version": "0.3.66",
    "description": "A React/MUI mail user agent UI — external IMAP/POP3/SMTP accounts, inbox/folders, compose, mobile sub-pages (pairs with the codeshop AS mua plugin)",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.esm.js",
            "require": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "restricted"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "node build.mjs",
        "type-check": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ehfuse/mua-ui.git"
    },
    "keywords": [
        "react",
        "mail",
        "mua",
        "imap",
        "pop3",
        "smtp",
        "material-ui",
        "mui",
        "typescript"
    ],
    "author": "김영진 <ehfuse@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/ehfuse/mua-ui/issues"
    },
    "homepage": "https://github.com/ehfuse/mua-ui#readme",
    "peerDependencies": {
        "@ehfuse/alerts": ">=1.1.4",
        "@ehfuse/editor": ">=1.2.1",
        "@ehfuse/file-viewer": ">=0.2.0",
        "@ehfuse/forma": ">=3.4.0",
        "@ehfuse/mui-dashboard-layout": ">=3.3.46",
        "@ehfuse/mui-form-controls": ">=3.2.7",
        "@ehfuse/mui-form-dialog": ">=1.8.1",
        "@ehfuse/mui-virtual-data-table": ">=1.1.30",
        "@ehfuse/taskbox": ">=0.5.391",
        "@emotion/react": ">=11.0.0",
        "@emotion/styled": ">=11.0.0",
        "@mui/icons-material": ">=6.0.0",
        "@mui/material": ">=6.0.0",
        "dompurify": ">=3.0.0",
        "entity-client": ">=1.0.31",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "react-router-dom": ">=6.0.0",
        "@dnd-kit/core": ">=6.3.1",
        "@dnd-kit/sortable": ">=10.0.0",
        "@dnd-kit/utilities": ">=3.2.2"
    },
    "devDependencies": {
        "@ehfuse/alerts": "^1.1.4",
        "@ehfuse/editor": "^1.2.1",
        "@ehfuse/file-viewer": "^0.2.0",
        "@ehfuse/forma": "^3.4.0",
        "@ehfuse/mui-dashboard-layout": "^3.3.46",
        "@ehfuse/mui-form-controls": "^3.2.7",
        "@ehfuse/mui-form-dialog": "^1.8.2",
        "@ehfuse/mui-virtual-data-table": "^1.1.30",
        "@ehfuse/taskbox": "^0.5.391",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^7.3.4",
        "@mui/material": "^7.3.7",
        "@types/dompurify": "^3.2.0",
        "@types/node": "^24.6.1",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "dompurify": "^3.3.0",
        "entity-client": "^1.0.31",
        "esbuild": "^0.27.0",
        "esbuild-plugin-d.ts": "^1.3.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router-dom": "^7.9.4",
        "tslib": "^2.8.1",
        "typescript": "~5.9.3",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2"
